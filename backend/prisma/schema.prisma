generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  supabaseId     String    @unique
  firstName      String
  lastName       String
  email          String    @unique
  phoneNumber    String
  emailVerified  Boolean   @default(false)
  phoneVerified  Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  resetTokens    PasswordResetToken[]
  verificationCodes EmailVerificationCode[]
  acceptedInvites   MemberRequest[] @relation("AcceptedInvites")

  @@map("users")
}

// 6-digit code emailed at signup. Only the hash is stored. A new code
// invalidates earlier unused ones; 5 wrong guesses burns a code.
model EmailVerificationCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("email_verification_codes")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  type         String
  typeOther    String?  @map("type_other")
  phone        String?
  website      String?
  ownerId      String   @map("owner_id")
  plan         String   @default("free")
  planStatus   String   @default("active") @map("plan_status")
  maxMembers   Int      @default(5) @map("max_members")
  maxLocations Int      @default(1) @map("max_locations")
  createdAt    DateTime @default(now()) @map("created_at")

  locations      Location[]
  members        OrgMember[]
  memberRequests MemberRequest[]

  @@map("organizations")
}

model Location {
  id        String       @id @default(uuid())
  orgId     String       @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  city      String?
  state     String?
  timezone  String?
  createdAt DateTime     @default(now()) @map("created_at")

  members   LocationMember[]
  requests  MemberRequest[]

  @@map("locations")
}

model OrgMember {
  id        String       @id @default(uuid())
  orgId     String       @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id")
  role      String       @default("member") // owner | admin | member (see src/organizations/roles.ts)
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([orgId, userId])
  @@map("org_members")
}

// Confirmed staff at a location (created when a MemberRequest is accepted)
model LocationMember {
  id         String   @id @default(uuid())
  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  role       String   @default("staff") // manager | staff
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([locationId, userId])
  @@map("location_members")
}

// Invite sent to an email for a specific location. Inviting one email to
// multiple locations creates multiple rows that share the same `token` —
// the token acts as the invite batch id, so one accept action grants every
// location in the batch at once.
// status: pending | accepted | declined | expired
model MemberRequest {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  locationId  String    @map("location_id")
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  email       String
  invitedById String    @map("invited_by_id")
  role        String    @default("staff") // what accepting grants: staff | manager | admin
  status      String    @default("pending")
  token       String
  expiresAt   DateTime  @map("expires_at")
  respondedAt DateTime? @map("responded_at")
  // Who accepted it. Set on accept; older accepted rows have none.
  acceptedByUserId String? @map("accepted_by_user_id")
  acceptedBy       User?   @relation("AcceptedInvites", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([token])
  @@map("member_requests")
}

model PromoCode {
  id         String    @id @default(uuid())
  code       String    @unique
  maxMembers Int       @map("max_members")
  maxUses    Int       @map("max_uses")
  usesCount  Int       @default(0) @map("uses_count")
  expiresAt  DateTime? @map("expires_at")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("promo_codes")
}
