generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  supabaseId     String    @unique
  firstName      String
  lastName       String
  email          String    @unique
  phoneNumber    String
  emailVerified  Boolean   @default(false)
  phoneVerified  Boolean   @default(false)
  // Dashboard cards the user has hidden (see src/auth/preferences.ts)
  hiddenDashboardCards String[] @default([])
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  resetTokens    PasswordResetToken[]
  verificationCodes EmailVerificationCode[]
  acceptedInvites   MemberRequest[] @relation("AcceptedInvites")
  positions         MemberPosition[]
  shifts            Shift[]         @relation("AssignedShifts")
  createdShifts     Shift[]         @relation("CreatedShifts")

  @@map("users")
}

// 6-digit code emailed at signup. Only the hash is stored. A new code
// invalidates earlier unused ones; 5 wrong guesses burns a code.
model EmailVerificationCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("email_verification_codes")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  type         String
  typeOther    String?  @map("type_other")
  phone        String?
  website      String?
  ownerId      String   @map("owner_id")
  plan         String   @default("free")
  planStatus   String   @default("active") @map("plan_status")
  maxMembers   Int      @default(5) @map("max_members")
  maxLocations Int      @default(1) @map("max_locations")
  createdAt    DateTime @default(now()) @map("created_at")

  locations      Location[]
  members        OrgMember[]
  memberRequests MemberRequest[]
  positions      Position[]
  shifts         Shift[]

  @@map("organizations")
}

model Location {
  id        String       @id @default(uuid())
  orgId     String       @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  city      String?
  state     String?
  timezone  String?
  createdAt DateTime     @default(now()) @map("created_at")

  members   LocationMember[]
  requests  MemberRequest[]
  shifts    Shift[]

  @@map("locations")
}

model OrgMember {
  id        String       @id @default(uuid())
  orgId     String       @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id")
  role      String       @default("member") // owner | admin | member (see src/organizations/roles.ts)
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([orgId, userId])
  @@map("org_members")
}

// Confirmed staff at a location (created when a MemberRequest is accepted)
model LocationMember {
  id         String   @id @default(uuid())
  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  role       String   @default("staff") // manager | staff
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([locationId, userId])
  @@map("location_members")
}

// Invite sent to an email for a specific location. Inviting one email to
// multiple locations creates multiple rows that share the same `token` —
// the token acts as the invite batch id, so one accept action grants every
// location in the batch at once.
// status: pending | accepted | declined | expired
model MemberRequest {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  locationId  String    @map("location_id")
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  email       String
  invitedById String    @map("invited_by_id")
  role        String    @default("staff") // what accepting grants: staff | manager | admin
  status      String    @default("pending")
  token       String
  expiresAt   DateTime  @map("expires_at")
  respondedAt DateTime? @map("responded_at")
  // Who accepted it. Set on accept; older accepted rows have none.
  acceptedByUserId String? @map("accepted_by_user_id")
  acceptedBy       User?   @relation("AcceptedInvites", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([token])
  @@map("member_requests")
}

model PromoCode {
  id         String    @id @default(uuid())
  code       String    @unique
  maxMembers Int       @map("max_members")
  maxUses    Int       @map("max_uses")
  usesCount  Int       @default(0) @map("uses_count")
  expiresAt  DateTime? @map("expires_at")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("promo_codes")
}

// A job a person can be scheduled as, e.g. "RN", "CNA", "Front desk".
// Defined per organization by its admins.
model Position {
  id        String       @id @default(uuid())
  orgId     String       @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  color     String       // hex, e.g. "#3B82F6"
  createdAt DateTime     @default(now()) @map("created_at")

  members MemberPosition[]
  shifts  Shift[]

  @@unique([orgId, name])
  @@map("positions")
}

// Positions a member is qualified to work.
model MemberPosition {
  id         String   @id @default(uuid())
  positionId String   @map("position_id")
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([positionId, userId])
  @@index([userId])
  @@map("member_positions")
}

// One shift at one location. Times are UTC instants; the web app shows them
// in the location's timezone. userId null = an open shift nobody has yet.
// status: draft (managers only) | published (visible to the assignee)
//       | cancelled (was published; kept so staff see it was called off)
// Upcoming / in progress / completed aren't stored: they follow from the times.
model Shift {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  locationId  String    @map("location_id")
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  userId      String?   @map("user_id")
  user        User?     @relation("AssignedShifts", fields: [userId], references: [id], onDelete: SetNull)
  positionId  String?   @map("position_id")
  position    Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime  @map("ends_at")
  notes       String?
  status      String    @default("draft")
  cancelledAt DateTime? @map("cancelled_at")
  // Set by a manager when the assignee didn't turn up.
  noShowAt    DateTime? @map("no_show_at")
  createdById String    @map("created_by_id")
  createdBy   User      @relation("CreatedShifts", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([locationId, startsAt])
  @@index([userId, startsAt])
  @@map("shifts")
}
